# Infra
REDIS_URL=redis://127.0.0.1:6379/0
DEVICE_REGISTRY_ENABLED=1
DEVICE_REGISTRY_DSN=postgresql://smt_user:smt_password@127.0.0.1:5432/smt_telematics
IPS_MAX_FUTURE_SEC=14400

# Tunnel / ports
# TUNNEL_HOST=your.vps.ip
# TUNNEL_USER=root
LOCAL_PORT=8088
REMOTE_PORT=8088
WIALON_IPS_PORT=18081
WIALON_IPS_REMOTE=18081
WEB_PORT=8080

# Modes
SKIP_TUNNEL=1
NO_BOT=0
NO_SNAPSHOT=0
NO_WEB=0
NO_WIALON=0
START_INFRA=0

# Units selection
RUN_UNITS=cached
