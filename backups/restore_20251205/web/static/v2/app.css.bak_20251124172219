:root {
  --bg: #1f252e;
  --panel: #222a34;
  --panel-light: #2c3440;
  --text: #e8edf5;
  --muted: #96a0b5;
  --accent: #4caf50;
  --danger: #ef5350;
  --row-h: 60px;
  --sidebar-width: 380px;
  --card-max-width: calc(var(--sidebar-width, 380px) - 20px);
  --pill-bg: #2f3744;
  --pill-border: #3c4656;
  --pill-text: #e8edf5;
  --pill-muted: #9aa5b8;
  --pill-success: #5ad68a;
  --pill-warn: #ffb74d;
  --pill-danger: #ef6c6c;
}
* { box-sizing: border-box; }
html, body { margin:0; padding:0; height:100%; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  display: flex;
  flex-direction: column;
}
.topbar, .bottombar {
  height: 44px;
  background: var(--panel);
  display: flex;
  align-items: center;
  padding: 0 10px;
  border-bottom: 1px solid #2b333f;
}
.bottombar { border-top: 1px solid #2b333f; border-bottom: none; }
.brand { font-weight: 700; margin-right: 12px; }
.tab { font-size: 13px; color: var(--muted); }
.layout {
  flex:1;
  display:grid;
  grid-template-columns: var(--sidebar-width, 380px) 6px 1fr;
  min-height:0;
}
.sidebar {
  background: var(--panel);
  border-right:1px solid #2b333f;
  display:flex;
  flex-direction:column;
  min-height:0;
  min-width:240px;
  width: var(--sidebar-width, 380px);
}
.resizer {
  background:#2b333f;
  cursor:col-resize;
  width:100%;
}
.resizer:hover,
.resizer.dragging {
  background:#3a4351;
}
.search-row { padding:10px; display:flex; gap:8px; align-items:center; }
.search-box { position:relative; flex:1; }
.search-box input {
  width:100%;
  padding:8px;
  padding-right:78px; /* место под ID-toggle внутри */
  border-radius:6px;
  border:1px solid #343d4b;
  background: var(--panel-light);
  color: var(--text);
}
.search-id-toggle {
  position:absolute;
  right:4px;
  top:4px;
  bottom:4px;
  transform:none;
  display:flex;
  align-items:center;
  gap:6px;
  font-size:13px;
  color: var(--muted);
  cursor:pointer;
  user-select:none;
  padding:0 10px;
  border:1px solid #3a4351;
  border-radius:6px;
  background: #1d2430;
}
.search-id-toggle input {
  margin:0;
  accent-color: var(--accent);
}
.search-actions {
  display:flex;
  gap:6px;
  align-items:center;
}
.search-row .primary.square {
  width:36px;
  height:36px;
  padding:0;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:6px;
  background: var(--accent);
  color:#0f1c0f;
  font-weight:900;
  font-size:20px;
}
.icon-btn {
  width:32px;
  height:32px;
  border:1px solid #3a4351;
  border-radius:6px;
  background:#2f3744;
  color:var(--text);
  cursor:pointer;
  font-size:15px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.icon-btn.active {
  border-color: var(--accent);
  background: rgba(76, 175, 80, 0.15);
}
.tabs-row {
  display:flex;
  align-items:center;
  gap:8px;
  padding:0 10px 10px;
}
.tabs {
  display:flex;
  flex-wrap:wrap;
  gap:6px;
}
.builder-header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:6px;
}
.tab-btn {
  background:#2f3744;
  border:1px solid #3a4351;
  border-radius:10px;
  padding:6px 10px;
  color:var(--text);
  font-size:12px;
  cursor:pointer;
  display:flex;
  align-items:center;
  gap:6px;
}
.tab-btn.active { border-color: var(--accent); color:#dff5df; }
.tab-btn .tab-close {
  background:transparent;
  border:none;
  color:var(--muted);
  cursor:pointer;
  font-size:14px;
  padding:0;
}
.ghost.small {
  padding:4px 8px;
  font-size:12px;
}
.unit-list {
  position: relative;
  flex:1;
  overflow-y: auto;
  overscroll-behavior: contain;
}
.unit-list-inner {
  position: relative;
  width:100%;
}
.unit-row {
  position:absolute;
  left:0; right:0;
  height: var(--row-h);
  display:grid;
  grid-template-columns: 1fr 60px 26px;
  gap:8px;
  padding:8px 10px;
  border-bottom:1px solid #2b333f;
  cursor:pointer;
  align-items:center;
  will-change: transform;
}
.unit-row:hover { background:#2b333f; }
.unit-row.is-selected { background:#27313f; border-color:#3a4351; }
.unit-name {
  font-weight:600;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  display:flex;
  align-items:center;
  gap:6px;
}
.unit-title {
  overflow:hidden;
  text-overflow:ellipsis;
}
.unit-type-icon {
  width:18px;
  height:18px;
  flex-shrink:0;
  filter: invert(86%) sepia(6%) saturate(553%) hue-rotate(186deg) brightness(96%) contrast(94%);
}
.unit-meta {
  font-size:12px;
  color:var(--muted);
  display:flex;
  gap:6px;
  align-items:center;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  min-width:0;
}
.ign-chip { color:#f0c36d; flex-shrink:0; }
.parking-chip { color:#1da1f2; font-weight:600; }
.unit-meta .dot { flex-shrink:0; }
.dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
.dot.online { background: var(--accent); }
.dot.offline { background: var(--danger); }
.map-area { position:relative; background:#111822; }
#map { position:absolute; inset:0; }
.unit-card {
  position:absolute;
  left:10px;
  right:10px;
  width:calc(100% - 20px);
  max-width: var(--card-max-width);
  min-width: 0;
  background: var(--panel);
  border:1px solid #343d4b;
  border-radius:12px;
  padding:6px 12px 12px;
  box-shadow:none;
  display:block;
  z-index:50;
}
.unit-card.hidden { display:none; }
.unit-card .label { color:var(--muted); font-size:12px; }
.card-head {
  display:flex;
  justify-content:space-between;
  gap:12px;
  align-items:center;
  margin-bottom:6px;
}
.card-head-main {
  display:flex;
  flex-direction:column;
  gap:3px;
  min-width:0;
}
.card-head-chips {
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-top:6px;
}
.card-head-subtitle {
  color:var(--muted);
  font-size:12px;
  word-break:break-word;
  white-space: normal;
}
.card-actions {
  display:flex;
  gap:8px;
  align-items:center;
  margin-left:auto;
  padding:2px 0;
}
.card-head-name {
  font-size:16px;
  font-weight:600;
  line-height:1.2;
  word-break:break-word;
  white-space: normal;
}
.card-chips { display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; }
.chip {
  border-radius:999px;
  padding:2px 10px;
  font-size:12px;
  border:1px solid #3a4351;
  background:#2c3440;
}
.card-head-chips .chip {
  background:#2f3744;
  border:1px solid #3a4351;
}
.chip-online { border-color:#3cb371; color:#caffda; }
.chip-offline { border-color:#b93b3b; color:#ffc4c4; }
.chip-fuel { border-color:#ffa726; color:#ffe0b2; }
.card-offline { font-size:12px; color:#f6baba; margin-top:4px; }
.muted { color: var(--muted); font-size:12px; }
.card-grid {
  display:flex;
  flex-direction:column;
  gap:3px;
  margin-top:3px;
}

.card-status-row {
  display:flex;
  align-items:flex-start;
  gap:12px;
  padding:10px;
  border:1px solid #2f3744;
  border-radius:10px;
  background:#1c222c;
}
.card-status-dot {
  width:10px;
  height:10px;
  border-radius:50%;
  margin-top:4px;
}
.card-status-dot.online { background: var(--accent); }
.card-status-dot.offline { background: var(--danger); }
.card-status-body {
  flex:1;
  display:flex;
  flex-direction:column;
  gap:2px;
}
.card-status-title {
  font-size:13px;
  font-weight:600;
}
.card-status-caption {
  font-size:12px;
  color:var(--muted);
}
.card-status-pill {
  padding:4px 8px;
  border-radius:999px;
  border:1px solid #3a4351;
  color: var(--muted);
  font-size:11px;
  line-height:1.2;
  white-space:nowrap;
}
.card-block {
  border:none;
  border-radius:10px;
  padding:10px;
  background:#1c222c;
  position:relative;
  box-shadow:0 1px 0 0 #2f3744 inset;
}
.card-block.card-block-edit {
  outline:1px dashed #3a4351;
}
.unit-card.card-layout-edit {
  border-color:#3cb371;
  box-shadow:0 0 0 1px rgba(60,179,113,0.35);
}
.card-layout-edit .card-block {
  padding:8px 10px;
  min-height:48px;
}
.card-layout-edit .card-block-body {
  display:none;
}
.card-block-body {
  color: var(--text);
  font-size:14px;
  line-height:1.45;
}
.card-block .label {
  color:var(--muted);
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:0.4px;
  margin-bottom:4px;
  display:block;
  font-weight:600;
}
.card-block-header {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}
.card-block-title {
  display:flex;
  align-items:center;
  gap:8px;
}
.card-block-body { margin-top:6px; }
/* kv-list styles removed: reverted to plain inline layout */
.section-handle {
  cursor:grab;
  color:var(--muted);
  font-size:14px;
  user-select:none;
  position:absolute;
  top:-8px;
  left:50%;
  transform:translateX(-50%);
  padding:2px 6px;
  background:#1c222c;
  border:1px solid #3a4351;
  border-radius:10px;
}
.card-block.drag-over {
  border-color: var(--accent);
  background:#223040;
}
.card-block.dragging {
  opacity:0.9;
}
.section-toggle {
  width:28px;
  height:28px;
  border-radius:6px;
  font-size:13px;
  padding:0;
}
.card-lines div { margin-bottom:2px; }
.unit-card .location-line {
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  align-items:center;
  margin-top:4px;
}
.geofence-list {
  display:flex;
  flex-wrap:wrap;
  gap:4px;
  margin-top:6px;
}
.geofence-chip {
  background:#2f3744;
  border:1px solid #3a4351;
  border-radius:12px;
  padding:2px 8px;
  font-size:11px;
  color:var(--accent);
}
.card-nearby-list {
  display:flex;
  flex-direction:column;
  gap:6px;
  margin-top:6px;
}
.nearby-row {
  display:flex;
  justify-content:space-between;
  gap:12px;
  border:1px solid #2f3744;
  border-radius:8px;
  padding:6px 10px;
  background:#252d39;
  color:var(--text);
  cursor:pointer;
}
.nearby-row span:last-child {
  color:var(--muted);
  font-size:12px;
}
.nearby-row:hover {
  border-color: var(--accent);
}
.unit-tooltip {
  position:fixed;
  pointer-events:none;
  background: var(--panel);
  border:1px solid #343d4b;
  border-radius:6px;
  padding:6px 8px;
  font-size:12px;
  color:var(--text);
  box-shadow:0 6px 16px rgba(0,0,0,0.4);
  z-index:6000;
}
.unit-tooltip.hidden { display:none; }
.spacer { flex:1; }
#status { font-size:13px; }
#clock { font-size:13px; color: var(--muted); }
button {
  border:none;
  background:#2f3744;
  color: var(--text);
  padding:6px 10px;
  border-radius:6px;
  cursor:pointer;
}
button:hover { border:1px solid #3a4351; }
.primary { background: var(--accent); color:#0f1c0f; font-weight:700; }
.danger { background: #ef5350; color:#fff; font-weight:700; }
.ghost { background:#1f2631; border:1px solid #3a4351; }
.ghost.icon {
  width:32px;
  height:32px;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0;
  font-size:15px;
}
.ghost.icon.edit-active {
  border-color: var(--accent);
  color: var(--accent);
}
.card-layout-edit .card-block { cursor:grab; }
.filter-builder .filter-rows {
  display:flex;
  flex-direction:column;
  gap:6px;
  margin-bottom:8px;
}
.filter-row {
  display:flex;
  gap:6px;
  align-items:center;
}
.filter-row select,
.filter-row input {
  flex:1;
  padding:6px 8px;
  border-radius:6px;
  border:1px solid #3a4351;
  background:#1a1f29;
  color:var(--text);
}
.filter-row button {
  padding:4px 8px;
}
.filter-actions {
  display:flex;
  gap:6px;
  justify-content:flex-end;
}

.checkbox-inline {
  display:flex;
  align-items:center;
  gap:8px;
}
.checkbox-inline input[type="checkbox"] {
  width:16px;
  height:16px;
  border-radius:4px;
  border:1px solid #3a4351;
  background:#1a1f29;
  appearance:none;
  -webkit-appearance:none;
  -moz-appearance:none;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  margin:0;
}
.checkbox-inline input[type="checkbox"]:focus {
  outline:none;
  box-shadow:0 0 0 1px var(--accent);
}
.checkbox-inline input[type="checkbox"]:checked {
  background: var(--accent);
  border-color: var(--accent);
}
.checkbox-inline input[type="checkbox"]:checked::after {
  content:"✓";
  font-size:11px;
  color:#0f1c0f;
}

/* Modal */
.modal-overlay {
  position:fixed; inset:0; background: rgba(0,0,0,0.55);
  display:flex; align-items:center; justify-content:center;
  z-index: 3000;
}
.modal-overlay.hidden { display:none; }
.modal {
  width: 760px;
  max-height: 80vh;
  background: var(--panel);
  border:1px solid #343d4b;
  border-radius:10px;
  display:flex;
  flex-direction:column;
  box-shadow:0 12px 30px rgba(0,0,0,0.45);
}
.modal.small {
  width:480px;
}
.modal-header {
  display:flex; align-items:center;
  padding:12px;
  border-bottom:1px solid #343d4b;
}
.modal-header h3 { margin:0; flex:1; }
.modal-header button { background:transparent; font-size:18px; }
.modal-filters {
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap:8px;
  padding:12px;
}
.modal-filters input {
  padding:8px;
  border-radius:6px;
  border:1px solid #343d4b;
  background: var(--panel-light);
  color: var(--text);
}
.modal-filters.two-col {
  grid-template-columns: repeat(2, minmax(0,1fr));
}
.modal-filters.two-col label {
  display:flex;
  align-items:center;
  gap:6px;
  font-size:13px;
}
.modal-filters.two-col .full {
  grid-column:1 / -1;
  display:flex;
  flex-direction:column;
  gap:4px;
}
.checkbox-row {
  display:flex;
  align-items:center;
  gap:8px;
  padding:0 12px 8px;
  color: var(--text);
}
.modal-list {
  margin:0 12px 12px;
  border:1px solid #2b333f;
  border-radius:6px;
  max-height: 360px;
  overflow:auto;
}
.modal-status {
  padding:0 12px 6px;
  font-size:12px;
  color: var(--muted);
}
.modal-row {
  display:grid;
  grid-template-columns: 28px 1fr 120px 80px;
  gap:8px;
  padding:8px 10px;
  border-bottom:1px solid #2b333f;
  align-items:center;
  cursor:pointer;
}
.modal-row:hover { background:#2b333f; }
.modal-row.checked { background:#34404f; }
.modal-row .unit-name { font-weight:600; }
.modal-row .unit-meta { font-size:12px; color:var(--muted); }
.modal-actions {
  display:flex;
  justify-content:space-between;
  gap:8px;
  padding:12px;
  border-top:1px solid #343d4b;
}
.modal-actions .left, .modal-actions .right { display:flex; gap:8px; }
.modal-actions.single-row {
  justify-content:flex-end;
}

.grid-two {
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
  /* ближе к плотности списка «Подключение»: меньше вертикальный зазор */
  gap:4px 12px;
}
.grid-two div {
  line-height:1.4;
  font-size:14px;
}

/* key-value pills */
.kv-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));
  gap:6px 12px;
}
.kv-pill {
  display:flex;
  align-items:baseline;
  gap:6px;
  min-height:24px;
  padding:6px 2px;
  border-radius:0;
  background: transparent;
  border:0;
  border-bottom:1px solid var(--pill-border);
  color: var(--pill-text);
  line-height:1.25;
}
.kv-pill.compact {
  min-height:22px;
  padding:4px 0;
  gap:6px;
}
.kv-pill .kv-icon {
  font-size:14px;
  opacity:0.9;
}
.kv-pill .kv-label {
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:0.02em;
  color: var(--pill-muted);
  white-space:nowrap;
}
.kv-pill .kv-divider {
  width:1px;
  height:16px;
  background: var(--pill-border);
  opacity:0.35;
}
.kv-pill .kv-value {
  font-size:13px;
  font-weight:700;
  color: var(--pill-text);
  overflow-wrap:anywhere;
}
.kv-value-link {
  color: var(--pill-text);
  cursor:pointer;
  text-decoration: underline dotted;
}
.kv-value-link:hover { color: var(--accent); }
.kv-value-link:active { color: var(--pill-muted); }
.kv-pill.tone-success {
  border-bottom-color: var(--pill-success);
}
.kv-pill.tone-success .kv-value { color: var(--pill-success); }
.kv-pill.tone-warn {
  border-bottom-color: var(--pill-warn);
}
.kv-pill.tone-warn .kv-value { color: var(--pill-warn); }
.kv-pill.tone-danger {
  border-bottom-color: var(--pill-danger);
}
.kv-pill.tone-danger .kv-value { color: var(--pill-danger); }
.kv-pill:focus-visible {
  outline:2px solid var(--accent);
  outline-offset:1px;
}
.card-block-body {
  display:flex;
  flex-direction:column;
  gap:8px;
}
.order-list {
  display:flex;
  flex-direction:column;
  gap:6px;
  margin-top:6px;
  max-height:360px;
  overflow:auto;
  padding-right:4px;
  padding-bottom:12px;
  flex:1;
}
.order-item {
  display:grid;
  grid-template-columns: 22px 1fr;
  align-items:center;
  gap:8px;
  padding:6px 10px;
  background:#2f3744;
  border:1px solid #3a4351;
  border-radius:10px;
  color:var(--text);
  cursor:grab;
  min-height:32px;
}
.order-item:active { cursor:grabbing; }
.order-item .handle {
  width:20px;
  height:20px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--muted);
  font-size:14px;
}
.order-item .title {
  font-size:13px;
  display:flex;
  align-items:center;
  gap:8px;
}
.order-item .title .label-text { flex:1; }
.order-item .title .pill {
  font-size:11px;
  padding:2px 8px;
  border-radius:999px;
  border:1px solid #3a4351;
  background:#1f2631;
  color:var(--muted);
}
.order-item.drag-over {
  border-color: var(--accent);
  background:#334254;
}
.order-item.locked {
  cursor:default;
  opacity:0.7;
}
.order-hint {
  font-size:12px;
  color:var(--muted);
  margin-bottom:6px;
}
.order-actions {
  display:flex;
  align-items:center;
  gap:8px;
  justify-content:space-between;
  margin-top:10px;
  padding-top:10px;
  border-top:1px solid #343d4b;
}
.modal-section.compact {
  display:flex;
  flex-direction:column;
  gap:8px;
  max-height:70vh;
}
