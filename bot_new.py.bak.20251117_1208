                f"<a href=\"{url}\">Открыть страницу логина Wialon</a>",
            )
    elif q.data == "auth:have_token":
        await q.message.reply_text("Отправьте токен сообщением — я его проверю и сохраню.")
    return STATE_AUTH_WAIT_TOKEN

