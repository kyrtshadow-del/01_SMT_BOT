def _env_token_list(name: str) -> List[str]:
    raw = _env_str(name, "")
    if not raw:
        return []
    parts = re.split(r"[\s,;]+", raw.replace("\n", " ").replace("\r", " "))
    tokens: List[str] = []
    for part in parts:
        token = part.strip()
        if token:
            tokens.append(token)
    return tokens


def _env_status_set(name: str, default: str) -> Set[int]:
    raw = _env_str(name, default)
    values: Set[int] = set()
    for part in raw.replace(";", ",").split(","):
        part = part.strip()
        if not part:
            continue
        try:
            value = int(part)
        except ValueError:
            continue
        if value > 0:
            values.add(value)
    return values


