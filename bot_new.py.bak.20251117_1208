        await send_new_anchor_below(
            update,
            "Введите минимум 3 символа для поиска",
            kb_search_prompt(context),
            context,
            parse_mode=None,
        )
        return STATE_FIND_QUERY

    id_match = ID_QUERY_RE.match(text)
