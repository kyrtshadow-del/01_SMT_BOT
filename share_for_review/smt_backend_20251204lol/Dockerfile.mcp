FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY . /app

RUN pip install --no-cache-dir --upgrade pip && \
    if [ -f requirements-dev.txt ]; then pip install --no-cache-dir -r requirements-dev.txt; fi

# Default storage/log paths match repo layout:
#   /app/data
#   /app/logs
ENV PIPELINE_STORAGE_ROOT=/app/data/pipeline_storage

CMD ["python", "-m", "pipeline.mcp.telemetry_server"]

